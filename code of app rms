          </div>

          <div className="flex-1 overflow-y-auto space-y-2 pr-2 custom-scrollbar">
             {selectedFoods.length === 0 ? (
                <div className="h-full flex flex-col items-center justify-center text-gray-600 space-y-3 opacity-60">
                   <div className="w-12 h-12 rounded-full border border-gray-700 flex items-center justify-center">
                      <Utensils size={20} />
                   </div>
                   <span className="text-sm">Plate is empty. Initialize selection.</span>
                </div>
             ) : (
                selectedFoods.map((f, i) => (
                   <div key={f.id} className="flex justify-between items-center p-3 bg-white/5 rounded-lg border border-white/5 text-sm animate-reveal group hover:bg-white/10 transition-colors">
                      <div className="truncate flex-1 pr-3 text-gray-300">{f.name}</div>
                      <div className="flex items-center gap-3">
                         <span className="text-lime-400 font-mono">{f.cal}</span>
                         <button onClick={() => removeFood(f.id)} className="text-gray-600 hover:text-red-400 transition-colors">
                            <X size={14} />
                         </button>
                      </div>
                   </div>
                ))
             )}
          </div>
          
          {selectedFoods.length > 0 && (
             <button 
                onClick={() => setSelectedFoods([])}
                className="mt-4 text-xs text-gray-500 hover:text-red-400 w-full text-center uppercase tracking-widest font-bold py-2 border-t border-white/5 transition-colors"
             >
                Reset Simulation
             </button>
          )}
       </div>
    </div>
  );
}

function ProHealthCheck({ userData, onCancel, onComplete, user }) {
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState('');
  const [inputs, setInputs] = useState({
    sleep: 7,
    stress: 5,
    water: 2,
    dietType: 'Omnivore',
    goals: '',
    struggles: ''
  });

  const generateReport = async () => {
    setLoading(true);
    setError('');

    try {
      const systemPrompt = `You are a high-performance health strategist AI. Analyze user data to provide a tactical, science-based health optimization protocol.
      Format: Markdown.
      Tone: Professional, direct, encouraging but not cheesy. Focus on metabolic efficiency and longevity.
      Sections:
      1. **Executive Status**: Current metabolic state summary.
      2. **System Strengths**: Biological advantages identified.
      3. **Optimization Vectors**: 3 specific behavioral upgrades.
      4. **Fueling Strategy**: Caloric and macronutrient directives.
      5. **Risk Assessment**: Potential pitfalls.`;
      
      const userPrompt = JSON.stringify({
        ...userData,
        ...inputs,
        bmi: calculateBMI(userData.weight, userData.height)
      });

      const response = await fetch(
        `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-preview-09-2025:generateContent?key=${apiKey}`,
        {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            contents: [{ parts: [{ text: userPrompt }] }],
            systemInstruction: { parts: [{ text: systemPrompt }] }
          })
        }
      );

      if (!response.ok) throw new Error('AI Service Busy');
      
      const result = await response.json();
      const reportText = result.candidates?.[0]?.content?.parts?.[0]?.text;

      if (!reportText) throw new Error('No analysis generated');

      const reportData = {
        userId: user.uid,
        createdAt: serverTimestamp(),
        inputs: { ...userData, ...inputs },
        report: reportText
      };

      await setDoc(doc(db, 'artifacts', appId, 'users', user.uid, 'ai_reports', `report_${Date.now()}`), reportData);
      onComplete(); 
    } catch (e) {
      console.error(e);
      setError('AI Processing Unit Overloaded. Retry sequence required.');
    } finally {
      setLoading(false);
    }
  };

  return (
    <div className="glass-panel rounded-2xl border border-white/10 overflow-hidden max-w-2xl mx-auto animate-reveal relative">
      <div className="absolute inset-0 bg-indigo-900/10 pointer-events-none"></div>
      
      <div className="bg-gradient-to-r from-indigo-900/80 to-violet-900/80 p-8 text-white relative border-b border-indigo-500/30">
        <div className="absolute top-0 right-0 p-3 opacity-20"><Brain size={120} /></div>
        <h2 className="text-3xl font-bold flex items-center gap-3 font-grotesk relative z-10">
          <Brain className="text-indigo-400" />
          Pro Health Analysis
        </h2>
        <p className="text-indigo-200 mt-2 text-sm max-w-md relative z-10 font-light">
          Deep-dive analysis of sleep, stress, and behavioral patterns.
        </p>
      </div>

      <div className="p-8 space-y-8 relative z-10">
        {error && (
          <div className="bg-red-500/10 border border-red-500/20 text-red-400 p-4 rounded-xl text-sm flex items-center gap-3">
             <AlertCircle size={18} />
             {error}
          </div>
        )}

        <div className="grid md:grid-cols-2 gap-8">
          <div>
             <label className="block text-xs uppercase tracking-wider text-gray-500 font-bold mb-3">Sleep Cycle Avg</label>

function ReportView({ report, onBack }) {
  if (!report) return null;

  const renderContent = (text) => {
    return text.split('\n').map((line, i) => {
      if (line.startsWith('## ') || line.startsWith('**Executive') || line.startsWith('**Key')) {
        return <h3 key={i} className="text-xl font-bold font-grotesk text-lime-400 mt-8 mb-4 tracking-wide">{line.replace(/#|\*/g, '')}</h3>;
      }
      if (line.startsWith('* ') || line.startsWith('- ')) {
        return <li key={i} className="ml-4 mb-3 text-gray-300 list-none flex gap-3">
          <span className="text-lime-500 mt-1.5 w-1.5 h-1.5 bg-lime-500 rounded-full shrink-0"></span>
          <span>{line.replace(/[*|-] /, '')}</span>
        </li>;
      }
      if (line.trim() === '') return <br key={i} />;
      return <p key={i} className="text-gray-300 leading-relaxed mb-3">{line.replace(/\*\*/g, '')}</p>;
    });
  };

  return (
    <div className="space-y-6 animate-reveal">
       <button onClick={onBack} className="text-gray-500 hover:text-white flex items-center gap-2 text-sm font-medium group transition-colors pl-2">
          <ChevronRight className="rotate-180 group-hover:-translate-x-1 transition-transform" size={16} />
          Return to Dashboard
       </button>

       <div className="glass-panel rounded-2xl border border-white/10 overflow-hidden relative">
          <div className="absolute top-0 w-full h-1 bg-gradient-to-r from-lime-400 via-white to-cyan-400"></div>
          
          <div className="bg-gradient-to-b from-white/5 to-transparent p-10 text-center">
             <div className="w-20 h-20 bg-lime-500/10 rounded-full flex items-center justify-center mx-auto mb-6 border border-lime-500/20 shadow-[0_0_30px_rgba(132,204,22,0.2)]">
                <Brain size={40} className="text-lime-400" />
             </div>
             <h1 className="text-3xl font-bold font-grotesk text-white">Analysis Report</h1>
             <p className="text-gray-400 text-sm mt-2 font-mono uppercase tracking-widest">ID: {report.id.slice(0,8)} • {new Date(report.createdAt?.seconds * 1000).toLocaleDateString()}</p>
          </div>
          
          <div className="p-10 max-w-4xl mx-auto">
             <div className="font-light text-lg">
                {renderContent(report.report)}
             </div>

             <div className="mt-12 p-6 bg-amber-900/10 border border-amber-500/20 rounded-xl flex gap-4">
                <Info className="text-amber-500 shrink-0" />
                <p className="text-sm text-amber-200/80 leading-relaxed">
                   <strong>Disclaimer:</strong> This automated report is generated via generative AI based on provided inputs. It serves as an informational guide and does not constitute medical diagnosis or prescription.
                </p>
             </div>
          </div>
       </div>
    </div>
  );
}

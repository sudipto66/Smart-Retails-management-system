        { name: 'items', label: 'Number of Items', type: 'number', required: true },
        { name: 'total', label: 'Total Amount ($)', type: 'number', step: "0.01", required: true },
        { name: 'status', label: 'Status', type: 'text', placeholder: 'e.g., Completed, Processing', required: true },
      ]
    },
    profile: {
      title: 'Edit Admin Profile',
      fields: [
        { name: 'name', label: 'Full Name', type: 'text', required: true },
        { name: 'role', label: 'Job Role', type: 'text', required: true },
        { name: 'email', label: 'Account Email', type: 'email', required: true },
      ]
    }
  };

  const config = formConfigs[type] || { title: 'Form', fields: [] };

  return (
    <div className="fixed inset-0 bg-slate-900/50 backdrop-blur-sm flex justify-center items-center z-50 animate-fade-in">
      <div className="bg-white rounded-xl shadow-2xl w-full max-w-md overflow-hidden max-h-[90vh] flex flex-col">
        <div className="px-6 py-4 border-b border-slate-100 flex justify-between items-center bg-slate-50 flex-shrink-0">
          <h3 className="font-bold text-lg text-slate-800">{config.title}</h3>
          <button onClick={onClose} className="text-slate-400 hover:text-slate-600"><X className="w-5 h-5" /></button>
        </div>
        <div className="overflow-y-auto flex-1">
          <form onSubmit={handleSubmit} className="p-6 space-y-4">
            {config.fields.map((field) => (
              <div key={field.name}>
                <div className="flex justify-between items-center mb-1">
                  <label className="block text-sm font-medium text-slate-700">{field.label}</label>
                  {field.aiAssist && (
                    <button
                      type="button"
                      onClick={() => handleAIAssist(field)}
                      disabled={isGeneratingAI}
                      className="text-xs font-medium text-indigo-600 hover:text-indigo-800 flex items-center disabled:opacity-50 transition"
                    >
                      {isGeneratingAI ? <Loader2 className="w-3 h-3 mr-1 animate-spin" /> : <Sparkles className="w-3 h-3 mr-1" />}
                      ✨ Auto-Write
                    </button>
                  )}
                </div>
                {field.type === 'textarea' ? (
                  <textarea
                    name={field.name}
                    required={field.required}
                    placeholder={field.placeholder}
                    value={formData[field.name] || ''}
                    onChange={handleChange}
                    rows={3}
                    className="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all text-slate-800 resize-none"
                  />
                ) : (
                  <input
                    type={field.type}
                    name={field.name}
                    step={field.step}
                    required={field.required}
                    placeholder={field.placeholder}
                    value={formData[field.name] || ''}
                    onChange={handleChange}
                    className="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all text-slate-800"
                  />
                )}
              </div>
            ))}
            <div className="pt-4 flex space-x-3">
              <button type="button" onClick={onClose} className="flex-1 px-4 py-2 border border-slate-300 text-slate-700 rounded-lg font-medium hover:bg-slate-50 transition">Cancel</button>
              <button type="submit" className="flex-1 px-4 py-2 bg-indigo-600 text-white rounded-lg font-medium hover:bg-indigo-700 transition flex justify-center items-center">
                <Save className="w-4 h-4 mr-2" /> Save
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  );
};


// --- MAIN APP COMPONENT ---
export default function App() {
  // Authentication & Navigation State
  const [isLoggedIn, setIsLoggedIn] = useState(false);
  const [activeTab, setActiveTab] = useState('dashboard');
  
  // App Data States
  const [products, setProducts] = useState(initialProducts);
  const [suppliers, setSuppliers] = useState(initialSuppliers);
  const [customers, setCustomers] = useState(initialCustomers);
  const [orders, setOrders] = useState(initialOrders);
  const [adminProfile, setAdminProfile] = useState({ name: 'Admin User', role: 'Administrator', email: 'admin@smartretail.com' });

  // UI States
  const [modalConfig, setModalConfig] = useState({ isOpen: false, type: null });
  const [toastMessage, setToastMessage] = useState(null);

  const showToast = (message, type = 'success') => {
    setToastMessage({ text: message, type });
  };

  const handleLogin = (e) => {
    e.preventDefault();
    setIsLoggedIn(true);
  };

  // --- CRUD Operations ---
  const handleAddItem = (type, data) => {
    const newId = Date.now(); // mock ID generation
    
    switch (type) {
      case 'product':
        setProducts(prev => [...prev, { id: newId, ...data, price: Number(data.price), stock: Number(data.stock) }]);
        showToast('Product added successfully!');
        break;
      case 'inventory':
        // special case: update existing stock based on SKU
        setProducts(prev => prev.map(p => p.sku === data.sku ? { ...p, stock: Number(data.stock) } : p));
        showToast('Inventory updated!');
        break;
      case 'supplier':
        setSuppliers(prev => [...prev, { id: newId, ...data }]);
        showToast('Supplier added successfully!');
        break;
      case 'customer':
        setCustomers(prev => [...prev, { id: newId, ...data, points: 0 }]);
        showToast('Customer added successfully!');
        break;
      case 'sales':
        setOrders(prev => [...prev, { id: newId, date: new Date().toISOString().split('T')[0], ...data, items: Number(data.items), total: Number(data.total) }]);
        showToast('Order recorded successfully!');
        break;
      case 'profile':
        setAdminProfile({ ...adminProfile, ...data });
        showToast('Profile updated successfully!');
        break;
      default:
        break;
    }
    setModalConfig({ isOpen: false, type: null });
  };

  const handleDeleteItem = (type, id) => {
    if (type === 'product') setProducts(prev => prev.filter(item => item.id !== id));
    if (type === 'inventory') setProducts(prev => prev.filter(item => item.id !== id)); // Deleting from inventory deletes product here
    if (type === 'supplier') setSuppliers(prev => prev.filter(item => item.id !== id));
    if (type === 'customer') setCustomers(prev => prev.filter(item => item.id !== id));
    if (type === 'sales') setOrders(prev => prev.filter(item => item.id !== id));
    showToast(`${type} record removed.`, 'info');
  };

  // Computed Data
  const totalRevenue = orders.reduce((sum, order) => sum + order.total, 0);
  const lowStockItems = products.filter(p => p.stock < 10);

  // Render Login
  if (!isLoggedIn) {
    return (
      <div className="min-h-screen bg-slate-100 flex items-center justify-center p-4">
        <div className="bg-white p-8 rounded-xl shadow-lg w-full max-w-md animate-fade-in-up">
          <div className="text-center mb-8">
            <div className="bg-indigo-600 p-3 rounded-full inline-block mb-3 shadow-md">
              <ShoppingCart className="text-white w-8 h-8" />
            </div>
            <h1 className="text-2xl font-bold text-slate-800">Smart Retail Admin</h1>
            <p className="text-slate-500 text-sm mt-1">Please sign in to your account</p>
          </div>
          <form onSubmit={handleLogin} className="space-y-4">
            <div>
              <label className="block text-sm font-medium text-slate-700 mb-1">Username</label>
              <input type="text" defaultValue="admin" required className="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all" />
            </div>
            <div>
              <label className="block text-sm font-medium text-slate-700 mb-1">Password</label>
              <input type="password" defaultValue="password" required className="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all" />
            </div>
            <button type="submit" className="w-full bg-indigo-600 text-white font-semibold py-2.5 rounded-lg hover:bg-indigo-700 transition-colors shadow-md mt-4">
              Sign In
            </button>
          </form>
        </div>
      </div>
    );
  }

  // Active Tab Router
  const renderContent = () => {
    switch (activeTab) {
      case 'dashboard': 
        return <DashboardView totalRevenue={totalRevenue} orders={orders} products={products} lowStockItems={lowStockItems} setActiveTab={setActiveTab} />;
      case 'products': 
        return <ProductsView products={products} onAdd={(type) => setModalConfig({isOpen: true, type})} onDelete={handleDeleteItem} />;
      case 'inventory': 
        return <GenericTableView 
          title="Inventory Control" type="inventory" icon={ClipboardList} data={products} onAdd={(type) => setModalConfig({isOpen: true, type})} onDelete={handleDeleteItem}
          columns={[
            { header: 'Product Name', key: 'name' },
            { header: 'SKU', key: 'sku', render: (val) => <span className="font-mono text-xs">{val}</span> },
            { header: 'Current Stock', key: 'stock', render: (val) => <span className={`font-bold ${val < 10 ? 'text-red-600' : 'text-slate-700'}`}>{val} units</span> },
            { header: 'Status', key: 'stock', render: (val) => val < 10 ? <span className="bg-red-100 text-red-700 px-2 py-1 rounded text-xs">Reorder Needed</span> : <span className="bg-green-100 text-green-700 px-2 py-1 rounded text-xs">In Stock</span> }
          ]} 
        />;
      case 'suppliers': 
        return <GenericTableView 
          title="Supplier Management" type="supplier" icon={Truck} data={suppliers} onAdd={(type) => setModalConfig({isOpen: true, type})} onDelete={handleDeleteItem}
          columns={[
            { header: 'Supplier Name', key: 'name', render: (val) => <span className="font-medium text-slate-900">{val}</span> },
            { header: 'Contact Person', key: 'contact' },
            { header: 'Email', key: 'email' },
            { header: 'Phone', key: 'phone' }
          ]} 
        />;
      case 'customers': 
        return <GenericTableView 
          title="Customer Management" type="customer" icon={Users} data={customers} onAdd={(type) => setModalConfig({isOpen: true, type})} onDelete={handleDeleteItem}
          columns={[
            { header: 'Customer Name', key: 'name', render: (val) => <span className="font-medium text-slate-900">{val}</span> },
            { header: 'Email', key: 'email' },
            { header: 'Phone', key: 'phone' },
            { header: 'Loyalty Points', key: 'points', render: (val) => <span className="text-indigo-600 font-bold">{val} pts</span> }
          ]} 
        />;
      case 'sales': 
        return <GenericTableView 
          title="Sales & Orders" type="sales" icon={Receipt} data={orders} onAdd={(type) => setModalConfig({isOpen: true, type})} onDelete={handleDeleteItem}
          columns={[
            { header: 'Order ID', key: 'id', render: (val) => <span className="font-mono text-slate-500">#{val}</span> },
            { header: 'Date', key: 'date' },
            { header: 'Items', key: 'items' },
            { header: 'Total Amount', key: 'total', render: (val) => <span className="font-bold text-slate-800">${Number(val).toFixed(2)}</span> },
            { header: 'Status', key: 'status', render: (val) => <span className={`px-2 py-1 rounded-full text-xs font-medium ${val === 'Completed' ? 'bg-green-100 text-green-700' : 'bg-blue-100 text-blue-700'}`}>{val}</span> }
          ]} 
        />;
      case 'reports':
        return <ReportsView products={products} orders={orders} lowStockItems={lowStockItems} onDownloadToast={(msg) => showToast(msg)} totalRevenue={totalRevenue} />;
      default: return <DashboardView totalRevenue={totalRevenue} orders={orders} products={products} lowStockItems={lowStockItems} setActiveTab={setActiveTab} />;
    }
  };

  const navItems = [
    { id: 'dashboard', label: 'Dashboard', icon: LayoutDashboard },
    { id: 'products', label: 'Products & Catalog', icon: Package },
    { id: 'inventory', label: 'Inventory Control', icon: ClipboardList },
    { id: 'suppliers', label: 'Suppliers & Purchases', icon: Truck },
    { id: 'customers', label: 'Customers', icon: Users },
    { id: 'sales', label: 'Sales & Orders', icon: Receipt },
    { id: 'reports', label: 'Analytics & Reports', icon: LineChart },
  ];

  return (
    <div className="flex h-screen bg-slate-50 font-sans text-slate-900 overflow-hidden">
      
      {/* Toast Notification */}
      {toastMessage && <Toast message={toastMessage.text} type={toastMessage.type} onClose={() => setToastMessage(null)} />}

      {/* Global Form Modal */}
      <FormModal 
        isOpen={modalConfig.isOpen} 
        type={modalConfig.type} 
        onClose={() => setModalConfig({ isOpen: false, type: null })} 
        onSubmit={handleAddItem} 
      />

      {/* Sidebar Navigation */}
      <aside className="w-64 bg-slate-900 text-slate-300 flex flex-col flex-shrink-0 shadow-xl z-10">
        <div className="p-6 flex items-center space-x-3 text-white">
          <div className="bg-indigo-500 p-2 rounded-lg shadow-inner">
            <ShoppingCart className="w-6 h-6" />
          </div>
          <span className="text-xl font-bold tracking-tight">SmartRetail</span>
        </div>
        
        <nav className="flex-1 px-4 space-y-1 overflow-y-auto mt-2">
          {navItems.map(item => {
            const Icon = item.icon;
            const isActive = activeTab === item.id;
            return (
              <button
                key={item.id}
                onClick={() => setActiveTab(item.id)}
                className={`w-full flex items-center space-x-3 px-4 py-3 rounded-lg transition-all text-sm font-medium ${
                  isActive 
                    ? 'bg-indigo-600 text-white shadow-md translate-x-1' 
                    : 'hover:bg-slate-800 hover:text-white'
                }`}
              >
                <Icon className={`w-5 h-5 ${isActive ? 'text-indigo-200' : 'text-slate-400'}`} />
                <span>{item.label}</span>
              </button>
            );
          })}
        </nav>

        {/* Profile / Admin Settings Trigger */}
        <div className="p-4 border-t border-slate-800">
          <div 
            onClick={() => setModalConfig({ isOpen: true, type: 'profile' })}
            className="flex items-center space-x-3 mb-4 px-2 py-2 rounded-lg cursor-pointer hover:bg-slate-800 transition group"
            title="Edit Profile"
          >
            <div className="w-8 h-8 rounded-full bg-slate-700 group-hover:bg-indigo-500 transition-colors flex items-center justify-center text-sm font-bold text-white">
               {adminProfile.name.charAt(0)}
            </div>
            <div className="flex-1 min-w-0">
              <p className="text-sm font-medium text-white truncate">{adminProfile.name}</p>
              <p className="text-xs text-slate-500 group-hover:text-slate-300 transition-colors truncate">{adminProfile.role}</p>
            </div>
          </div>
          <button 
            onClick={() => { setIsLoggedIn(false); setActiveTab('dashboard'); }}
            className="w-full flex items-center space-x-2 px-4 py-2 rounded-lg text-sm font-medium text-slate-400 hover:bg-slate-800 hover:text-red-400 transition-colors"
          >
            <LogOut className="w-4 h-4" />
            <span>Logout</span>
          </button>
        </div>
      </aside>

      {/* Main Content Area */}
      <main className="flex-1 flex flex-col overflow-hidden relative">
        <header className="bg-white border-b border-slate-200 h-16 flex items-center justify-between px-8 flex-shrink-0 z-10 shadow-sm">
          <h1 className="text-xl font-semibold text-slate-800 capitalize flex items-center">
            {activeTab.replace('-', ' ')}
          </h1>
          <div className="flex items-center space-x-4">
             <div className="hidden md:flex text-sm text-slate-500 mr-4 items-center">
               <UserIcon className="w-4 h-4 mr-2" /> {adminProfile.email}
             </div>
            <button className="text-slate-400 hover:text-orange-500 transition-colors relative" onClick={() => setActiveTab('inventory')}>
              <AlertTriangle className="w-5 h-5" />
              {lowStockItems.length > 0 && <span className="absolute -top-1 -right-1 w-2 h-2 bg-red-500 rounded-full animate-pulse"></span>}
            </button>
          </div>
        </header>

        {/* Scrollable Workspace */}
        <div className="flex-1 overflow-auto p-8 bg-slate-50/50">
          <div className="max-w-7xl mx-auto">
            {renderContent()}
          </div>
        </div>
      </main>

    </div>
  );
}

function FoodExplorer({ calorieTarget }) {
  const [filter, setFilter] = useState('all'); 
  const [selectedFoods, setSelectedFoods] = useState([]);
  
  const currentCals = selectedFoods.reduce((acc, curr) => acc + curr.cal, 0);
  const remaining = calorieTarget - currentCals;

  const toggleFood = (food) => {
    setSelectedFoods(prev => [...prev, { ...food, id: Date.now() }]);
  };

  const removeFood = (id) => {
    setSelectedFoods(prev => prev.filter(f => f.id !== id));
  };

  const filteredDB = FOOD_DB.filter(f => {
    if (filter === 'all') return true;
    if (filter === 'veg') return f.type === 'veg';
    if (filter === 'non-veg') return f.type === 'non-veg';
    return true;
  });

  return (
    <div className="grid lg:grid-cols-3 gap-8 h-[650px] animate-reveal">
       {/* Food List */}
       <div className="lg:col-span-2 glass-panel rounded-2xl flex flex-col overflow-hidden border border-white/10">
          <div className="p-6 border-b border-white/5 flex justify-between items-center bg-white/5">
             <h3 className="font-bold text-white font-grotesk text-lg">Nutrient Database</h3>
             <div className="flex bg-black/40 p-1 rounded-lg border border-white/5">
                {['all', 'veg', 'non-veg'].map(f => (
                  <button
                    key={f}
                    onClick={() => setFilter(f)}
                    className={`px-4 py-1.5 rounded-md text-xs font-bold uppercase tracking-wider transition-all ${filter === f ? 'bg-lime-500/20 text-lime-400 shadow-[0_0_10px_rgba(132,204,22,0.2)]' : 'text-gray-500 hover:text-gray-300'}`}
                  >
                    {f}
                  </button>
                ))}
             </div>
          </div>
          <div className="overflow-y-auto flex-1 p-6 grid grid-cols-1 sm:grid-cols-2 gap-4 custom-scrollbar">
             {filteredDB.map((food, idx) => (
                <button 
                  key={idx}
                  onClick={() => toggleFood(food)}
                  className="flex items-center justify-between p-4 rounded-xl border border-white/5 bg-white/[0.02] hover:bg-lime-500/10 hover:border-lime-500/30 transition-all group text-left relative overflow-hidden"
                >
                   <div className="absolute inset-0 bg-lime-400/5 translate-x-[-100%] group-hover:translate-x-0 transition-transform duration-300"></div>
                   <div className="relative z-10">
                      <div className="font-semibold text-gray-200 text-sm group-hover:text-white transition-colors">{food.name}</div>
                      <div className="text-xs text-gray-500 mt-1">{food.unit} • <span className={food.cat === 'Protein' ? 'text-blue-400' : food.cat === 'Carbs' ? 'text-amber-400' : 'text-purple-400'}>{food.cat}</span></div>
                   </div>
                   <div className="flex items-center gap-3 relative z-10">
                      <span className="font-bold text-lime-400 font-mono">{food.cal}</span>
                      <div className="w-6 h-6 rounded-full bg-lime-500/20 text-lime-400 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-all transform translate-x-2 group-hover:translate-x-0">
                         <Check size={14} />
                      </div>
                   </div>
                </button>
             ))}
          </div>
       </div>

       {/* Calculator / Plate */}
       <div className="glass-panel rounded-2xl p-6 flex flex-col border border-white/10 relative overflow-hidden">
          <div className="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-lime-500 to-cyan-500"></div>
          <h3 className="font-bold text-white mb-6 flex items-center gap-3 font-grotesk text-lg">
             <Utensils className="text-lime-400" size={20} />
             Daily Intake Simulation
          </h3>
          
          <div className="bg-black/40 border border-white/10 p-5 rounded-xl mb-6 relative overflow-hidden">
             <div className="absolute -right-4 -top-4 w-24 h-24 bg-lime-500/10 rounded-full blur-2xl"></div>
             <div className="flex justify-between text-xs text-gray-400 uppercase tracking-wider mb-2 font-bold">
                <span>Total Accumulated</span>
                <span>Target: {Math.round(calorieTarget)}</span>
             </div>
             <div className="flex items-end gap-2 mb-3">
               <div className="text-4xl font-bold text-white font-grotesk tracking-tight">{currentCals}</div>
               <div className="text-sm font-medium text-gray-500 mb-1.5">kcal</div>
             </div>
             
             <div className="w-full h-2 bg-gray-800 rounded-full overflow-hidden">
                <div 
                   className={`h-full rounded-full transition-all duration-700 ease-out shadow-[0_0_10px_currentColor] ${remaining < 0 ? 'bg-red-500 text-red-500' : 'bg-lime-400 text-lime-400'}`} 
                   style={{ width: `${Math.min((currentCals / calorieTarget) * 100, 100)}%` }}
                ></div>
             </div>
             <div className="text-xs text-right mt-3 font-mono">
                {remaining > 0 ? (
                   <span className="text-lime-400">{remaining} kcal remaining</span>

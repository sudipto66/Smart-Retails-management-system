// --- MAIN APPLICATION COMPONENT ---

export default function App() {
  const [user, setUser] = useState(null);
  const [view, setView] = useState('loading'); // loading, onboarding, dashboard, proCheck, report
  const [userData, setUserData] = useState({
    age: '',
    gender: 'male',
    height: '',
    weight: '',
    activity: 'sedentary',
    goal: 'maintain',
    name: ''
  });
  const [loading, setLoading] = useState(true);
  const [aiReports, setAiReports] = useState([]);

  useEffect(() => {
    const initAuth = async () => {
      try {
        if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
          await signInWithCustomToken(auth, __initial_auth_token);
        } else {
          await signInAnonymously(auth);
        }
      } catch (e) {
        console.error("Auth error:", e);
      }
    };
    initAuth();

    return onAuthStateChanged(auth, (u) => {
      setUser(u);
      if (!u) setLoading(false);
    });
  }, []);

  useEffect(() => {
    if (!user) return;
    
    const fetchUserData = async () => {
      try {
        const docRef = doc(db, 'artifacts', appId, 'users', user.uid, 'profile', 'basic');
        const snap = await getDoc(docRef);
        
        if (snap.exists()) {
          setUserData(snap.data());
          setView('dashboard');
        } else {
          setView('onboarding');
        }
      } catch (e) {
        console.error("Fetch error", e);
        setView('onboarding');
      } finally {
        setLoading(false);
      }
    };
    fetchUserData();

    const q = collection(db, 'artifacts', appId, 'users', user.uid, 'ai_reports');
    const unsubscribeReports = onSnapshot(q, (snapshot) => {
      const reports = snapshot.docs.map(d => ({ id: d.id, ...d.data() }));
      reports.sort((a, b) => (b.createdAt?.seconds || 0) - (a.createdAt?.seconds || 0));
      setAiReports(reports);
    }, (err) => console.error("Snapshot error", err));

    return () => unsubscribeReports();
  }, [user]);

  const saveProfile = async (data) => {
    if (!user) return;
    setUserData(data);
    try {
      await setDoc(doc(db, 'artifacts', appId, 'users', user.uid, 'profile', 'basic'), data);
    } catch (e) {
      console.error("Save error", e);
    }
  };

  if (loading) return (
    <Background>
      <div className="min-h-screen flex items-center justify-center text-lime-400">
        <div className="relative">
          <div className="absolute inset-0 bg-lime-400 blur-xl opacity-20 animate-pulse"></div>
          <Loader2 className="animate-spin w-12 h-12 relative z-10" />
        </div>
      </div>
    </Background>
  );

  return (
    <Background>
      <Header setView={setView} user={user} currentView={view} />
      
      <main className="max-w-5xl mx-auto p-6 pt-24 pb-20">
        {view === 'onboarding' && (
          <Onboarding onComplete={(data) => {
            saveProfile(data);
            setView('dashboard');
          }} />
        )}

        {view === 'dashboard' && (
          <Dashboard 
            userData={userData} 
            setView={setView} 
            aiReports={aiReports}
          />
        )}

        {view === 'proCheck' && (
          <ProHealthCheck 
            userData={userData} 
            onCancel={() => setView('dashboard')}
            onComplete={() => setView('dashboard')} 
            user={user}
          />
        )}

        {view === 'report' && (
           <ReportView 
             report={aiReports[0]} 
             onBack={() => setView('dashboard')}
           />
        )}
      </main>
    </Background>
  );
}


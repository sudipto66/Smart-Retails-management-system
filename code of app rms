const Toast = ({ message, type, onClose }) => {
  useEffect(() => {
    const timer = setTimeout(onClose, 3000);
    return () => clearTimeout(timer);
  }, [message, onClose]);

  if (!message) return null;

  return (
    <div className="fixed bottom-4 right-4 z-50 flex items-center bg-slate-800 text-white px-4 py-3 rounded-lg shadow-xl animate-fade-in-up">
      {type === 'success' ? <CheckCircle2 className="w-5 h-5 text-green-400 mr-3" /> : <Info className="w-5 h-5 text-blue-400 mr-3" />}
      <span className="font-medium">{message}</span>
      <button onClick={onClose} className="ml-4 text-slate-400 hover:text-white">
        <X className="w-4 h-4" />
      </button>
    </div>
  );
};

